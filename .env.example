# Copy to .env for local development. On Render, set these in the dashboard (no .env file).

# ----- Auth (required for JWT) -----
JWT_SECRET=your_jwt_secret_for_auth
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Demo user (single-user auth)
AUTH_DEMO_USERNAME=admin
AUTH_DEMO_PASSWORD=admin

# ----- Optional: environment label (health check) -----
APP_ENV=local

# ----- Contract workflow (required for /contract/process) -----
# Provider-agnostic LLM: set one of GEMINI_API_KEY, GROQ_API_KEY, or AZURE_OPENAI_API_KEY
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key
# GROQ_API_KEY=your_groq_api_key
# AZURE_OPENAI_API_KEY=your_azure_key
# AZURE_OPENAI_BASE_URL=https://your-resource.openai.azure.com/
GSHEETS_WEBAPP_URL=https://script.google.com/macros/s/.../exec

# ----- Optional: token reduction (chars) – lower = fewer tokens per run -----
# MAX_CONTRACT_CHARS=12000
# MAX_AUDIT_CHARS=4000
# MAX_NEMO_CHARS=6000

# ----- Model splitting (Gemini: extraction vs evaluation/guardrails, 15 RPM) -----
# LLM_MODEL_EXTRACTION=gemini-2.5-flash   (extraction node only)
# LLM_MODEL_AUXILIARY=gemini-2.5-flash-lite   (Judge + NeMo; 15 RPM)
# USE_JUDGE_EVAL=true   (single Judge call for Faithfulness + Relevancy + Schema)
# NEMO_OUTPUT_RAILS_ENABLED=false   (input-only NeMo; saves one LLM call)
# 12s jittered delay before auditor (stays within 15 RPM); set 0 to disable
# AUDITOR_DELAY_MIN_SECONDS=10
# AUDITOR_DELAY_MAX_SECONDS=14

# ----- Optional: model behaviour -----
# LLM_TEMPERATURE=0.1
# LLM_EVAL_TEMPERATURE=0.0
# GROQ_BASE_URL=https://api.groq.com  (only when LLM_PROVIDER=groq)

# ----- NeMo guardrails (optional): uses GROQ_API_KEY; config/rails/config.yml; output rails off by default -----

# ----- Self-healing & routing -----
# MAX_EXTRACTION_RETRIES=2
# CONFIDENCE_THRESHOLD=0.8
# AUDIT_TIMEOUT_SECONDS=15
